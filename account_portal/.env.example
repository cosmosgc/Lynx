# Copy this file to account_portal/.env and set a unique secret.
# This app is a development account portal; run it on loopback only.
PORT=5050
HOST=127.0.0.1
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Nakama public HTTP API configuration. Use HTTPS except for literal loopback.
NAKAMA_URL=http://127.0.0.1:7350
NAKAMA_SERVER_KEY=defaultkey

# Set true only when the app is served behind HTTPS.
COOKIE_SECURE=false
