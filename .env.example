# Lynx environment template
#
# Copy this file to .env (which is gitignored) and fill in the values. The
# scripts load .env from the repository root, but variables already set in the
# process environment win.
#
# Never commit a real .env, password, token, or key.

# -- PostgreSQL -------------------------------------------------------------
# Native setup: scripts/setup-postgres.*; migrations: scripts/db-migrate.*
LYNX_PG_HOST=127.0.0.1
LYNX_PG_PORT=5432
LYNX_PG_DATABASE=lynx
LYNX_PG_USER=lynx
# Required. Use a high-entropy value; never reuse a production password.
LYNX_PG_PASSWORD=

# Superuser used only by scripts/setup-postgres.*. It authenticates through
# libpq (peer auth, a pgpass file, or PGPASSWORD), not through LYNX_PG_PASSWORD.
LYNX_PG_SUPERUSER=postgres
LYNX_PG_MAINTENANCE_DB=postgres

# -- Nakama -----------------------------------------------------------------
# Nakama 3.41.0 binary name or absolute path.
NAKAMA_BIN=nakama
LYNX_NAKAMA_URL=http://127.0.0.1:7350
LYNX_NAKAMA_LOG_LEVEL=info

# Console credentials. Loopback-only in development; change them anywhere else.
LYNX_NAKAMA_CONSOLE_USER=admin
LYNX_NAKAMA_CONSOLE_PASSWORD=

# The socket server key is public client configuration and the Basic key used by
# Lynx's Nakama HTTP adapter (`LYNX_NAKAMA_HTTP_KEY` in lynx-world). It must
# match, but is not Nakama's runtime HTTP invocation key below.
LYNX_NAKAMA_SERVER_KEY=

# Independent, high-entropy, single-line secrets. Generate each independently
# (for example 32 random bytes encoded base64url). Never use Nakama defaults in
# a persistent or networked deployment.
LYNX_NAKAMA_CONSOLE_SIGNING_KEY=
LYNX_NAKAMA_SESSION_ENCRYPTION_KEY=
LYNX_NAKAMA_REFRESH_ENCRYPTION_KEY=
LYNX_NAKAMA_RUNTIME_HTTP_KEY=

# Optional, default-off Prometheus listener. Nakama binds it unauthenticated on
# all interfaces, so allow it only on a private scrape network/firewall rule.
# Set 0 or leave empty to disable.
LYNX_NAKAMA_METRICS_PORT=

# -- World service ----------------------------------------------------------
# SHA-256 hashes of accepted static bearer tokens, comma- or space-separated.
# Generate one with: lynx-world token-hash < token.txt
# Each hash grants one demo character; a plaintext token must never be stored.
LYNX_WORLD_TOKEN_HASHES=
